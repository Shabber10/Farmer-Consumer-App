{
  "expo": {
    "name": "KisanDirect",
    "slug": "farmer-consumer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/assets/images/bg1_hd.jpg",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./src/assets/images/bg6_hd.jpg",
      "resizeMode": "contain",
      "backgroundColor": "#246B45"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kisandirect.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/assets/images/bg1_hd.jpg",
        "backgroundColor": "#246B45"
      },
      "package": "com.kisandirect.mobile",
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./src/assets/images/bg1_hd.jpg"
    }
  }
}
